            }

            .workload-total-row td {
                background: #f1f5f9 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            /* Signatures */
            .inst-signatures-block {
                margin-top: 30px !important;
                page-break-inside: avoid;
            }

            .sig-text {
                font-size: 10px !important;
            }
        }
