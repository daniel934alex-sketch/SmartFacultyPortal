<?php
require_once "../includes/auth-check.php";
require_once "../includes/role-check.php";
requireRole('FACULTY');

require_once "../config/database.php";

$user_id = (int)$_SESSION['user_id'];

/* =========================================================
   1. GET AUTHENTICATED FACULTY INFORMATION
========================================================= */
$faculty_sql = "
    SELECT
        f.faculty_id,
        f.faculty_code,
        f.faculty_name,
        f.designation,
        f.email,
        f.phone,
        f.department_id,
        d.department_name,
        d.department_code
    FROM faculty f
    LEFT JOIN departments d ON d.department_id = f.department_id
    WHERE f.user_id = ?
    LIMIT 1
";

$faculty_stmt = $conn->prepare($faculty_sql);
if (!$faculty_stmt) {
    die("Faculty query preparation failed: " . htmlspecialchars($conn->error));
}
$faculty_stmt->bind_param("i", $user_id);
$faculty_stmt->execute();
$faculty_result = $faculty_stmt->get_result();

if ($faculty_result->num_rows === 0) {
    die("Faculty record not found.");
}

$faculty = $faculty_result->fetch_assoc();
$faculty_id = (int)$faculty['faculty_id'];
$faculty_stmt->close();

/* =========================================================
   2. GET ACADEMIC CLASS / SEMESTER INFORMATION
========================================================= */
$academic = null;

$academic_sql = "
    SELECT DISTINCT
        ac.academic_year,
        ac.semester_number,
        ac.year_number,
        d.department_name
    FROM timetable t
    INNER JOIN sections sec ON sec.section_id = t.section_id
    INNER JOIN academic_classes ac ON ac.class_id = sec.class_id
    LEFT JOIN departments d ON d.department_id = ac.department_id
    WHERE t.faculty_id = ?
    LIMIT 1
";

$academic_stmt = $conn->prepare($academic_sql);
if ($academic_stmt) {
    $academic_stmt->bind_param("i", $faculty_id);
    $academic_stmt->execute();
    $academic_res = $academic_stmt->get_result();
    if ($academic_res->num_rows > 0) {
        $academic = $academic_res->fetch_assoc();
    }
    $academic_stmt->close();
}

if (!$academic) {
    $fallback_res = $conn->query("
        SELECT ac.academic_year, ac.semester_number, ac.year_number, d.department_name
        FROM academic_classes ac
        LEFT JOIN departments d ON d.department_id = ac.department_id
        ORDER BY ac.class_id DESC
        LIMIT 1
    ");
    if ($fallback_res && $fallback_res->num_rows > 0) {
        $academic = $fallback_res->fetch_assoc();
    }
}

$academicYear = $academic['academic_year'] ?? '2026-2027';
$semesterNum  = (int)($academic['semester_number'] ?? 3);
$yearNum      = (int)($academic['year_number'] ?? 2);
$deptName     = !empty($faculty['department_name']) 
    ? $faculty['department_name'] 
    : ($academic['department_name'] ?? 'Computer Science and Engineering');

/* =========================================================
   3. GET ALL PERIODS FROM DATABASE
========================================================= */
$periods = [];
$period_sql = "SELECT period_id, period_number, start_time, end_time FROM periods ORDER BY period_number ASC";
$period_res = $conn->query($period_sql);

if ($period_res) {
    while ($pRow = $period_res->fetch_assoc()) {
        $num = (int)$pRow['period_number'];
        $sTime = date('H:i', strtotime($pRow['start_time']));
        $eTime = date('H:i', strtotime($pRow['end_time']));
        $periods[$num] = [
            'period_id'     => (int)$pRow['period_id'],
            'period_number' => $num,
            'start_time'    => $pRow['start_time'],
            'end_time'      => $pRow['end_time'],
            'formatted'     => $sTime . '–' . $eTime
        ];
    }
}

// Fallback timings if database has missing slots
$defaultTimings = [
    1 => '08:30–09:15',
    2 => '09:15–10:00',
    3 => '10:00–10:45',
    4 => '11:00–11:45',
    5 => '11:45–12:30',
    6 => '12:30–13:15',
    7 => '14:00–14:45',
    8 => '14:45–15:30',
    9 => '15:45–16:30'
];

for ($i = 1; $i <= 9; $i++) {
    if (!isset($periods[$i])) {
        $periods[$i] = [
            'period_id'     => $i,
            'period_number' => $i,
            'formatted'     => $defaultTimings[$i]
        ];
    }
}

/* =========================================================
   4. GET PUBLISHED TIMETABLE ENTRIES FOR LOGGED-IN FACULTY
========================================================= */
$days = [
    'MONDAY',
    'TUESDAY',
    'WEDNESDAY',
    'THURSDAY',
    'FRIDAY',
    'SATURDAY'
];

$grid = [];
foreach ($days as $d) {
    $grid[$d] = [];
}

$timetable_sql = "
    SELECT
        t.timetable_id,
        t.day,
        t.period_id,
        t.status,
        p.period_number,
        p.start_time,
        p.end_time,
        s.subject_id,
        s.subject_code,
        s.subject_name,
        s.subject_type,
        sec.section_id,
        sec.section_name,
        c.classroom_id,
        c.room_number,
        c.room_type,
        c.floor
    FROM timetable t
    INNER JOIN periods p ON p.period_id = t.period_id
    INNER JOIN subjects s ON s.subject_id = t.subject_id
    INNER JOIN sections sec ON sec.section_id = t.section_id
    INNER JOIN classrooms c ON c.classroom_id = t.classroom_id
    WHERE t.faculty_id = ?
      AND t.status = 'PUBLISHED'
    ORDER BY
        FIELD(t.day, 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'),
        p.period_number
";

$tt_stmt = $conn->prepare($timetable_sql);
if (!$tt_stmt) {
    die("Timetable query preparation failed: " . htmlspecialchars($conn->error));
}
$tt_stmt->bind_param("i", $faculty_id);
$tt_stmt->execute();
$tt_res = $tt_stmt->get_result();

$assignedCount = 0;
$theoryCount   = 0;
$labCount      = 0;
$subjectSummary = [];

while ($row = $tt_res->fetch_assoc()) {
    $day  = strtoupper($row['day']);
    $pNum = (int)$row['period_number'];

    if (isset($grid[$day])) {
        $grid[$day][$pNum] = $row;
        $assignedCount++;

        if (strtoupper($row['subject_type']) === 'LAB') {
            $labCount++;
        } else {
            $theoryCount++;
        }

        $sCode = $row['subject_code'];
        if (!isset($subjectSummary[$sCode])) {
            $subjectSummary[$sCode] = [
                'code'     => $row['subject_code'],
                'name'     => $row['subject_name'],
                'type'     => $row['subject_type'],
                'sections' => [],
                'rooms'    => [],
                'count'    => 0
            ];
        }
        $subjectSummary[$sCode]['count']++;
        if (!in_array($row['section_name'], $subjectSummary[$sCode]['sections'])) {
            $subjectSummary[$sCode]['sections'][] = $row['section_name'];
        }
        if (!in_array($row['room_number'], $subjectSummary[$sCode]['rooms'])) {
            $subjectSummary[$sCode]['rooms'][] = $row['room_number'];
        }
    }
}
$tt_stmt->close();

$firstLetter = strtoupper(substr(trim($faculty['faculty_name'] ?? 'F'), 0, 1));
?>
