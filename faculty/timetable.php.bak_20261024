            background: #e0f2fe;
            color: #0369a1;
            border: 1px solid #bae6fd;
        }

        .type-badge.lab {
            background: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
        }

        .workload-total-row td {
            font-weight: 800;
            background: #f1f5f9;
            color: #000000;
            font-size: 12.5px;
        }

        /* =========================================================
           8. INSTITUTIONAL SIGNATURES BLOCK
           ========================================================= */
        .inst-signatures-block {
            margin-top: 48px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding-top: 10px;
        }

        .signature-item {
            text-align: center;
            width: 22%;
        }

        .sig-line {
            height: 1px;
            background: #000000;
            margin-bottom: 8px;
        }

        .sig-text {
            font-size: 11.5px;
            font-weight: 700;
            color: #000000;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* =========================================================
           9. RESPONSIVE DESIGN (Screen View)
           ========================================================= */
        @media (max-width: 900px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .topbar {
                padding: 0 16px;
            }

            .content {
                padding: 16px 14px;
            }

            .timetable-paper-panel {
                padding: 20px 14px;
            }

            .inst-faculty-meta-grid {
                grid-template-columns: 1fr;
            }

            .meta-cell {
                border-right: none;
                border-bottom: 1px solid var(--paper-border);
            }

            .controls-card {
                flex-direction: column;
                align-items: stretch;
            }

            .controls-group {
                justify-content: space-between;
            }
        }

        /* =========================================================
           10. PRINT STYLESHEET (Landscape A4 Single Page Fit)
           ========================================================= */
        @media print {
            @page {
                size: landscape A4;
                margin: 6mm 8mm;
            }

            *, *::before, *::after {
                background: transparent !important;
                color: #000000 !important;
                box-shadow: none !important;
                text-shadow: none !important;
            }

            html, body {
                background: #ffffff !important;
                color: #000000 !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                font-size: 10.5pt !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            /* Hide Portal Navigation, Topbar, and Controls */
            .sidebar,
            .topbar,
            .controls-card,
            .no-print {
                display: none !important;
            }

            .main-wrapper {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
            }

            .content {
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
            }

            .timetable-paper-panel {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
            }

            .inst-header-block {
                margin-bottom: 12px !important;
                padding-bottom: 8px !important;
                border-bottom: 2px solid #000000 !important;
            }

            .inst-college-title {
                font-size: 11px !important;
                color: #000000 !important;
            }

            .inst-dept-title {
                font-size: 18px !important;
                color: #000000 !important;
                margin-bottom: 4px !important;
            }

            .inst-doc-title {
                font-size: 12.5px !important;
                color: #000000 !important;
            }

            /* Meta info grid */
            .inst-faculty-meta-grid {
                margin-bottom: 12px !important;
                border: 1px solid #000000 !important;
            }

            .meta-cell {
                border-right: 1px solid #000000 !important;
                border-bottom: 1px solid #000000 !important;
                padding: 4px 8px !important;
                font-size: 11px !important;
            }

            .meta-cell:nth-child(3n) {
                border-right: none !important;
            }

            .meta-cell:nth-last-child(-n+3) {
                border-bottom: none !important;
            }

            .meta-cell .lbl {
                color: #000000 !important;
                font-weight: 700 !important;
            }

            /* Main Timetable Grid */
            .inst-table-container {
                overflow: visible !important;
                margin-bottom: 14px !important;
                border: 2px solid #000000 !important;
            }

            table.inst-grid {
                width: 100% !important;
                min-width: 100% !important;
                border-collapse: collapse !important;
                page-break-inside: avoid;
            }

            table.inst-grid th,
            table.inst-grid td {
                border: 1px solid #000000 !important;
                color: #000000 !important;
                padding: 4px 2px !important;
            }

            .col-day-th,
            .day-label-th {
                background: #f1f5f9 !important;
                color: #000000 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-size: 11px !important;
                height: 58px !important;
            }

            .cell-class,
            .cell-free {
                height: 58px !important;
                padding: 3px 2px !important;
            }

            .cell-subject-code {
                font-size: 11.5px !important;
                font-weight: 800 !important;
                color: #000000 !important;
            }

            .cell-subject-name {
                font-size: 9.5px !important;
                color: #000000 !important;
            }

            .tag-sec,
            .tag-room,
            .tag-lab-badge {
                border: 1px solid #000000 !important;
                background: transparent !important;
                color: #000000 !important;
                font-size: 9px !important;
                padding: 0 3px !important;
            }

            /* Vertical Lunch Break in Print */
            td.lunch-vertical-col {
                background: #f1f5f9 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                border: 1px solid #000000 !important;
                width: 38px !important;
                min-width: 38px !important;
                max-width: 38px !important;
            }

            .lunch-vertical-text {
                color: #000000 !important;
                font-size: 11px !important;
                letter-spacing: 4px !important;
            }

            /* Workload section in print */
            .inst-workload-section {
                margin-top: 14px !important;
                padding-top: 10px !important;
                page-break-inside: avoid;
                border-top: 1px solid #000000 !important;
            }

            .workload-title {
                font-size: 11.5px !important;
                margin-bottom: 6px !important;
            }

            table.workload-table {
                font-size: 10px !important;
                border: 1px solid #000000 !important;
            }

            table.workload-table th,
            table.workload-table td {
                border: 1px solid #000000 !important;
                padding: 4px 6px !important;
            }

            .type-badge {
                border: 1px solid #000000 !important;
